# ──────────────────────────────────────────
# PDSN Media — Admin Panel Configuration
# ──────────────────────────────────────────
# Copy this file to .env.local and fill in values.
# .env.local is NEVER committed to git.

# Admin panel password (required to log in at /admin)
ADMIN_PASSWORD=Screen@123

# ── Publish Live (GitHub CDN Sync) ──────────
# Generate a Personal Access Token at:
#   https://github.com/settings/tokens → New token → select "repo" scope
GITHUB_TOKEN=ghp_your_token_here

# The GitHub repo that hosts your CDN assets (already used for images)
GITHUB_REPO=ops-pdsn/cdn-assets

# Branch to push data files to (default: main)
GITHUB_BRANCH=main
